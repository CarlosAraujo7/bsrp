# Python
__pycache__/
*.pyc

# Q-tables pickle (~110 MB, regeneráveis; hashes em results/MANIFEST_pkl.sha256)
results/*.pkl

# Dados brutos coletados (Tembici): licença de redistribuição NÃO verificada -> não versionar
data/

# Temporários
*.tmp
.venv/

# logs de processos em segundo plano
runs/*.out
runs/*.err

# fila de execucoes (22_queue.py): temporarios e logs por execucao
runs/_q/

# artigo: artefatos de compilacao LaTeX
artigo/*.aux
artigo/*.log
artigo/*.bbl
artigo/*.blg
artigo/*.out
artigo/*.toc
artigo/*.fls
artigo/*.fdb_latexmk
artigo/*.synctex.gz
artigo/main.pdf

# artigo do CEC: artefatos de compilacao LaTeX (o PDF final fica fora do repo: duplo-anonimo, versao de trabalho)
artigo_cec/*.aux
